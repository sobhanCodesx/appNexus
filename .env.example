# Production / explicit override
EXPO_PUBLIC_PLAYNEXUS_URL=https://playnexus.ir
# EXPO_PUBLIC_PLAYNEXUS_API_URL=https://playnexus.ir/api/v1

# Local Expo LAN development:
# When EXPO_PUBLIC_PLAYNEXUS_API_URL is omitted, the app automatically
# derives the PC LAN IP from Expo/Metro and uses:
# http://<metro-lan-ip>:8000/api/v1
EXPO_PUBLIC_PLAYNEXUS_LOCAL_API_PORT=8000

# Google Sign-In
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
